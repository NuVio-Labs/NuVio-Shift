# Supabase project connection.
# Copy this file to .env.local and fill in the values from your
# Supabase project dashboard: Project Settings -> API.

# Project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable API key (Project Settings -> API -> Publishable key).
# This is Supabase's current recommended name for the public client key
# (successor to the legacy "anon" key) and is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push VAPID keys (M9). Generate with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose to the browser.
# VAPID_PRIVATE_KEY must stay server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
